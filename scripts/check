#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
./scripts/format --check
mkdir -p build
./scripts/mojo precompile -I src src/mojo_s3 -o build/mojo_s3.mojoc
for test in crypto signing signing_differential xml protocol retry multipart properties threads credentials ranges_pagination transfers data_plane identity checksum_algorithms transfer_control multipart_plan download_plan public_api; do
    ./scripts/build "tests/test_${test}.mojo" "build/test_${test}"
    "build/test_${test}"
done
for test in http transport_failures tls concurrent_failures checksums; do
    ./scripts/build "tests/test_${test}.mojo" "build/test_${test}"
done
python3 scripts/run_fault_tests.py "$PWD/build/test_http" "$PWD/build/test_transport_failures" "$PWD/build/test_concurrent_failures" "$PWD/build/test_checksums"
python3 scripts/run_tls_test.py "$PWD/build/test_tls"
for test in data_plane_faults identity_network download_faults; do
    ./scripts/build "tests/test_${test}.mojo" "build/test_${test}"
done
python3 scripts/run_data_plane_faults.py "$PWD/build/test_data_plane_faults"
python3 scripts/run_identity_fixtures.py "$PWD/build/test_identity_network"
python3 scripts/run_download_faults.py "$PWD/build/test_download_faults"
./scripts/build tests/test_multipart_api_faults.mojo build/test_multipart_api_faults
python3 scripts/run_multipart_api_faults.py "$PWD/build/test_multipart_api_faults"
./scripts/build tests/test_assume_role.mojo build/test_assume_role
python3 scripts/run_assume_role_fixtures.py "$PWD/build/test_assume_role"
./scripts/build tests/test_large_stream.mojo build/test_large_stream
python3 scripts/run_large_stream.py "$PWD/build/test_large_stream"
./scripts/build tests/test_late_cancel.mojo build/test_late_cancel
python3 scripts/run_late_cancel.py "$PWD/build/test_late_cancel"
./scripts/build tests/test_aws.mojo build/test_aws
for example in examples/*.mojo; do
    ./scripts/build "$example" "build/$(basename "$example" .mojo)"
done
if [[ "${RUN_S3_INTEGRATION:-0}" == 1 ]]; then
    : "${S3_TEST_BUCKET:?Set an isolated S3_TEST_BUCKET}"
    ./scripts/build tests/test_integration.mojo build/test_integration
    build/test_integration
    ./scripts/build tests/test_data_plane_integration.mojo build/test_data_plane_integration
    build/test_data_plane_integration
    if [[ -n "${S3_STREAM_SOURCE:-}" && -n "${S3_STREAM_DESTINATION:-}" ]]; then
        for test in streaming multipart_integration concurrent_integration transfers_integration; do
            ./scripts/build "tests/test_${test}.mojo" "build/test_${test}"
            "build/test_${test}"
        done
    fi
fi

if [[ "${RUN_EXTENDED_KEYS:-0}" == 1 ]]; then
    ./scripts/build tests/test_extended_keys.mojo build/test_extended_keys
    build/test_extended_keys
fi
if [[ "${RUN_S3_CHECKSUMS:-0}" == 1 ]]; then
    ./scripts/build tests/test_checksums_integration.mojo build/test_checksums_integration
    build/test_checksums_integration
fi
