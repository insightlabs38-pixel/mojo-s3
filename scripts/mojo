#!/usr/bin/env bash
set -euo pipefail
export XDG_CACHE_HOME="${XDG_CACHE_HOME:-/tmp/mojo-s3-cache}"
export XDG_DATA_HOME="${XDG_DATA_HOME:-/tmp/mojo-s3-data}"
mojo_s3_compiler="${MOJO:-mojo}"
if ! command -v "$mojo_s3_compiler" >/dev/null && [[ -x /workspace/mojo-toolchain/bin/mojo ]]; then
    mojo_s3_compiler=/workspace/mojo-toolchain/bin/mojo
fi
exec "$mojo_s3_compiler" "$@"
