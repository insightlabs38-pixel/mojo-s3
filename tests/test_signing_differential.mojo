            "ce5dea902709a409005a495872b9b0055d2e749b3696a0d729e30f54bf2c0590",
        ),
    ]
    var result = sign(
        Credentials("TESTACCESS", "test-secret-fixture", "test-session-token"),
        "us-east-1",
        "s3",
        "DELETE",
        "/bucket/z_0z0%25.0/%E9%9B%AAa%23a%E9%9B%AA_%3D%C3%A9%26A%E9%9B%AA%3D9%23%26",
        query,
        headers,
        hash_text("payload-é-63"),
        "20261004T120000Z",
    )
    assert_equal(
        result.canonical_request,
        "DELETE\n/bucket/z_0z0%25.0/%E9%9B%AAa%23a%E9%9B%AA_%3D%C3%A9%26A%E9%9B%AA%3D9%23%26\nduplicate=%20a&duplicate=z&empty=&prefix=%3Da%2B%20%20%2B\nhost:example.test:9443\nx-amz-content-sha256:ce5dea902709a409005a495872b9b0055d2e749b3696a0d729e30f54bf2c0590\nx-amz-date:20261004T120000Z\nx-amz-meta-duplicate:first,second value\nx-amz-meta-note:a b c\nx-amz-security-token:test-session-token\n\nhost;x-amz-content-sha256;x-amz-date;x-amz-meta-duplicate;x-amz-meta-note;x-amz-security-token\nce5dea902709a409005a495872b9b0055d2e749b3696a0d729e30f54bf2c0590",
    )
    assert_equal(
        result.signature,
        "e9e45e4c50015b9cccf56b6bfaf23028289c1716820d30aacfe0d89bd1d05263",
    )


